#!/usr/bin/env bash
# Digest filed context into brain memory, on the operator's machine.
#
# For each project with a repo in ~/.nashcode/people.json: take a lock, pull the
# checkout to the default-branch tip, and run Claude Code headless with the
# context-digest skill once per undigested file. Claude gets Read, Edit and Write and no shell, so it never
# runs git; this script owns git. Before every commit the working tree is checked: a
# changed path outside context/, brain/ or tasks/ aborts the run and leaves the
# checkout dirty for a person.
#
# After the digest and before the push, still inside the lock, `bin/context-tasks`
# mirrors the claimed cards to the operator's Google Tasks list and the list back to
# the cards, so its commits travel with the digest's.
#
# The push is fenced by `host` in the config, which is the only host this will ever
# push to. github.com is refused by name: client code lives there, and context/ and
# brain/ are exactly what must not.
#
# Usage:
#   bin/context-digest                 every project with a repo in the people file
#   bin/context-digest <repo>          just that one
#   bin/context-digest /path/to/repo   an existing checkout, for testing; no clone,
#                                      no pull, and `host` still gates the push
#
# Not CI. CI checks out a historical commit detached, with no push identity, and quick
# pushes queue stale jobs. The digest needs the current tip, a push identity, and one
# run at a time.
set -euo pipefail

NASHCODE_HOME="${NASHCODE_HOME:-$HOME/.nashcode}"
CONFIG="$NASHCODE_HOME/context.toml"
PEOPLE="${NASHCODE_PEOPLE:-$NASHCODE_HOME/people.json}"
CHECKOUTS="$NASHCODE_HOME/checkouts"
STATE="$NASHCODE_HOME/state"
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

die() { printf 'context-digest: %s\n' "$*" >&2; exit 1; }
say() { printf 'context-digest: %s\n' "$*"; }

command -v claude >/dev/null 2>&1 || die "claude is not on PATH"
command -v python3 >/dev/null 2>&1 || die "python3 is not on PATH"
# No lock, no run. Two digests in one checkout would race on the same files, and a
# missing tool is not a reason to find out what that looks like.
command -v flock >/dev/null 2>&1 || die "flock is not on PATH (brew install util-linux)"

# --- config ------------------------------------------------------------------------
# tomllib is stdlib from Python 3.11, so the config needs no third-party parser.

# `host` is the runner's, in context.toml. Which repositories get a digest is the
# people file's: every project with a `repo`, in file order.

read_config() { # <expression>
  python3 - "$CONFIG" "$PEOPLE" "$1" <<'PY'
import json, pathlib, sys, tomllib

config, people, want = pathlib.Path(sys.argv[1]), pathlib.Path(sys.argv[2]), sys.argv[3]
if want == "host":
    data = tomllib.loads(config.read_text()) if config.exists() else {}
    host = data.get("host", "")
    print(host.strip() if isinstance(host, str) else "")
elif want == "repos":
    # One line and a nonzero exit, never a traceback and never an empty list: a
    # people file nobody can read must stop the run, not read as no work.
    if not people.exists():
        print(f"context-digest: no people file at {people}", file=sys.stderr)
        sys.exit(1)
    try:
        data = json.loads(people.read_text())
    except json.JSONDecodeError as problem:
        print(f"context-digest: {people} is not JSON: {problem}", file=sys.stderr)
        sys.exit(1)
    if not isinstance(data, dict):
        print(f"context-digest: {people} is not a JSON object", file=sys.stderr)
        sys.exit(1)
    seen = []
    for project in data.get("projects") or []:
        repo = str(project.get("repo") or "").strip()
        if repo and repo not in seen:
            seen.append(repo)
    print("\n".join(seen))
PY
}

HOST="$(read_config host)"

# --- the checkout ------------------------------------------------------------------

ensure_checkout() { # <repo> -> prints the path
  local repo="$1" dir="$CHECKOUTS/$repo"
  if [ ! -d "$dir/.git" ]; then
    [ -n "$HOST" ] || die "no clone URL: ~/.nashcode/context.toml has no top-level host"
    mkdir -p "$CHECKOUTS"
    git clone "https://$HOST/$repo.git" "$dir" >&2 \
      || die "$repo: clone from $HOST failed"
  fi
  printf '%s\n' "$dir"
}

# The host a remote URL points at: https://host/path and git@host:path both.
remote_host() { # <url>
  local url="$1"
  case "$url" in
    *://*)
      url="${url#*://}"
      url="${url#*@}"
      printf '%s\n' "${url%%[:/]*}"
      ;;
    *@*:*)
      url="${url#*@}"
      printf '%s\n' "${url%%:*}"
      ;;
    *) printf '\n' ;;
  esac
}

# Every path git reports as changed, tracked or not, one per line.
changed_paths() {
  git -c core.quotepath=false status --porcelain -uall | while IFS= read -r line; do
    [ -n "$line" ] || continue
    local path="${line:3}"
    # A rename reads "old -> new"; the destination is the one that matters.
    case "$path" in *' -> '*) path="${path##* -> }" ;; esac
    path="${path%\"}"
    path="${path#\"}"
    printf '%s\n' "$path"
  done
}

# Refuse the whole run when Claude wrote outside the three directories it was given.
# Dirty on purpose: a person reads the diff and decides, and a `git checkout .` here
# would throw away the evidence of what went wrong.
check_paths() {
  local stray="" path
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    case "$path" in
      context/*|brain/*|tasks/*) ;;
      *) stray="$stray  $path"$'\n' ;;
    esac
  done < <(changed_paths)
  if [ -n "$stray" ]; then
    printf 'context-digest: the digest changed paths outside context/, brain/ and tasks/:\n%s' "$stray" >&2
    die "nothing committed; the checkout is left dirty for you to read"
  fi
}

# --- one repository ----------------------------------------------------------------

digest_checkout() { # <dir> <label> <pull:yes|no>
  local dir="$1" label="$2" pull="$3"
  # Checked, every time. `( run_repo )` turns errexit off inside the subshell, so a
  # cd that failed would leave Claude and `git commit` running in the caller's
  # checkout — this repository's digest, committed to whatever repository you were
  # standing in.
  cd "$dir" || die "$label: cannot enter $dir"

  if [ "$pull" = "yes" ]; then
    git pull --ff-only >&2 || die "$label: pull failed; fix the checkout and run again"
  fi

  # Undigested means `digested: false` in the *front matter*, between the opening
  # `---` and the one that closes it. Matching anywhere in the file would re-digest
  # forever any item that quotes a front-matter block — an email about this very
  # system, say — because the digest sets the real key to true and the quotation
  # stays. Null-delimited throughout, so a path with a space or a newline in it is
  # still one path.
  local files=() file
  while IFS= read -r -d '' file; do
    if awk '
        NR == 1 { if ($0 != "---") { bad = 1; exit } ; next }
        $0 == "---" { exit }
        /^digested:[ \t]*false[ \t]*$/ { found = 1 }
        END { exit (bad || !found) ? 1 : 0 }
      ' "$file"; then
      files+=("$file")
    fi
  done < <(find context -type f -name '*.md' -print0 2>/dev/null | sort -z)

  if [ "${#files[@]}" -eq 0 ]; then
    say "$label: nothing undigested"
    return 0
  fi

  local file id
  for file in "${files[@]}"; do
    id="$(basename "$file" .md)"
    say "$label: digesting $file"
    # Read, Edit, Write and nothing else, allowed and denied both ways round so a
    # default that changes under us cannot quietly widen this. No Bash: Claude never
    # runs git, and the file's own text — an email that asks the reader to run
    # something, fetch a URL, or hand the job to a subagent — has nothing to reach for
    # even if the skill's rules were ignored.
    claude -p "Run the context-digest skill on: $file" \
      --allowedTools Read,Edit,Write \
      --disallowedTools Bash,WebFetch,WebSearch,Task \
      --permission-mode acceptEdits >&2 || die "$label: claude failed on $file"

    check_paths
    if [ -z "$(git status --porcelain)" ]; then
      say "$label: $id produced no changes"
      continue
    fi
    # Everything, because check_paths has already proved every changed path is inside
    # context/, brain/ and tasks/. Naming the three directories instead fails with
    # exit 128 and an empty index the moment one of them does not exist yet — which is
    # the ordinary first run in a repo with no tasks/.
    git add -A .
    git commit -q -m "context: digest $id"
    say "$label: committed context: digest $id"
  done
}

# The Google Tasks mirror, after the digest and before the push, inside this run's
# lock. Its commits ride out on the same push. It failing is a nonzero exit for the
# run and nothing more: the digest's commits are already made, and holding them back
# because a task list could not be read would leave the checkout ahead of the server
# for as long as Google was unhappy.
sync_tasks() { # <dir> <label>
  local dir="$1" label="$2"
  cd "$dir" || die "$label: cannot enter $dir"
  if [ ! -x "$HERE/context-tasks" ]; then
    say "$label: $HERE/context-tasks is missing, so no cards were mirrored"
    return 1
  fi
  "$HERE/context-tasks" "$dir" "$label"
}

push_checkout() { # <dir> <label>
  local label="$2" url host
  cd "$1" || die "$label: cannot enter $1"
  url="$(git remote get-url origin 2>/dev/null || true)"
  [ -n "$url" ] || die "$label: no origin remote, so there is nowhere to push"
  host="$(remote_host "$url")"

  if [ "$host" = "github.com" ]; then
    die "$label: origin is github.com — context/ and brain/ are private and are never pushed there"
  fi
  [ -n "$HOST" ] || die "$label: ~/.nashcode/context.toml sets no top-level host, so no push is allowed"
  [ "$host" = "$HOST" ] || die "$label: origin is $host, and the only host this pushes to is $HOST"

  # Digests go on the default branch, like board moves. `git push origin HEAD` would
  # follow whatever the checkout happens to be on — a detached head, or a branch
  # somebody left behind — and either invent a remote branch or push the wrong one.
  local branch default
  branch="$(git symbolic-ref --short HEAD 2>/dev/null || true)"
  [ -n "$branch" ] || die "$label: the checkout is on a detached head, so there is no branch to push"
  default="$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null || true)"
  default="${default#origin/}"
  [ -n "$default" ] || die "$label: origin has no HEAD, so the default branch is unknown; run \`git remote set-head origin -a\`"
  [ "$branch" = "$default" ] || die "$label: the checkout is on $branch, not the default branch $default; nothing pushed"

  git push origin "HEAD:refs/heads/$default" >&2
  say "$label: pushed $default to $host"
}

# One repository, start to finish. Run this in a subshell: `die` inside it ends the
# subshell, not the whole run, so one broken repository does not take the others with
# it. The lock is released when that subshell exits.
run_repo() { # <repo>
  local repo="$1" dir lock
  mkdir -p "$STATE"
  lock="$STATE/$repo.lock"
  exec 9>"$lock"
  if ! flock -n 9; then
    say "$repo: another run holds $lock; skipping"
    return 0
  fi
  # The clone is inside the lock. Two runs that both found the checkout missing would
  # otherwise clone into the same directory at the same time.
  # Checked: `die` inside a command substitution ends the substitution's subshell and
  # nothing more, so a clone that failed would come back as an empty path and the run
  # would carry on into `cd ""`.
  dir="$(ensure_checkout "$repo")" || die "$repo: there is no checkout to digest"
  digest_checkout "$dir" "$repo" yes
  local tasks=0
  sync_tasks "$dir" "$repo" || tasks=1
  push_checkout "$dir" "$repo"
  return "$tasks"
}

# --- what to run -------------------------------------------------------------------

target="${1:-}"

if [ -n "$target" ] && [ -d "$target/.git" ]; then
  # A checkout named by path: this is the test shape. No clone and no pull — there may
  # be no reachable remote at all — but `host` still decides whether the push happens.
  label="$(basename "$target")"
  dir="$(cd "$target" && pwd)" || die "$label: cannot enter $target"
  mkdir -p "$STATE"
  exec 9>"$STATE/$label.lock"
  if ! flock -n 9; then
    say "$label: another run holds the lock; skipping"
    exit 0
  fi
  digest_checkout "$dir" "$label" no
  tasks=0
  sync_tasks "$dir" "$label" || tasks=1
  push_checkout "$dir" "$label"
  exit "$tasks"
fi

[ -f "$CONFIG" ] || die "no config at $CONFIG"

repos=()
if [ -n "$target" ]; then
  repos=("$target")
else
  # Captured, not streamed from a process substitution: a substitution throws its
  # exit code away, so an unreadable people file would read as nothing to digest.
  listed="$(read_config repos)" || die "the people file at $PEOPLE could not be read"
  while IFS= read -r repo; do
    [ -n "$repo" ] || continue
    repos+=("$repo")
  done <<< "$listed"
fi
[ "${#repos[@]}" -gt 0 ] || die "no project in $PEOPLE has a repo, so there is nothing to digest"

# A subshell each, so one repository that cannot be cloned, pulled, digested or pushed
# is one nonzero exit at the end rather than the end of the run.
trouble=0
for repo in "${repos[@]}"; do
  ( run_repo "$repo" ) || trouble=1
done
exit "$trouble"
