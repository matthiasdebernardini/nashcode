{
  "name": "nashcode-assets",
  "version": "0.1.0",
  "private": true,
  "description": "Browser asset bundle (JS + CSS) for the nashcode Rust server, built into Cargo's OUT_DIR by build.rs",
  "type": "module",
  "scripts": {
    "build:js": "esbuild js/app.js --bundle --format=esm --minify --target=es2022 --outfile=dist/nashcode.js",
    "build:css": "esbuild js/app.css --bundle --minify --loader:.woff=file --loader:.woff2=file --loader:.svg=dataurl --outfile=dist/nashcode.css"
  },
  "dependencies": {
    "@ibm/plex-mono": "^2.5.0",
    "@phosphor-icons/web": "^2.1.2",
    "@pierre/diffs": "^1.3.5",
    "@primer/css": "^21.5.1",
    "@primer/primitives": "^10.7.0",
    "mermaid": "^11.16.1",
    "shiki": "^3.0.0 || ^4.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.25"
  }
}
